# Reference values for trusted processes. tools/start_local.ps1 does not load this file.
# Startup compatibility change: Start/Restart no longer provision PostgreSQL,
# bootstrap demo identities, or enroll runners. Complete the separate setup in
# docs/DARK_FACTORY_CONTRIBUTOR_GUIDE.md, then supply the authorized DATABASE_URL,
# existing CRONY_CORP_ID, CRONY_ACTOR_ID and matching CRONY_RUNNER_ID in the process
# environment. Retain output/runner/credential.json; do not replace an existing identity.
DATABASE_URL=postgres://crony:crony@127.0.0.1:54329/crony
CRONY_BIND=127.0.0.1:8791
CRONY_SERVER_HTTP=http://127.0.0.1:8791
CRONY_SERVER_WS=ws://127.0.0.1:8791/ws/runner
CRONY_RUNNER_ID=runner-local
CRONY_CORP_ID=00000000-0000-4000-8000-000000000001
# CRONY_ACTOR_ID=<existing authorized actor UUID>
CRONY_RUNNER_CREDENTIAL_FILE=./output/runner/credential.json
# Explicit initial enrollment only; the local starter does not use this fallback.
CRONY_RUNNER_ENROLLMENT_TOKEN_FILE=./output/runner/enrollment.token
CRONY_RUNNER_WORKSPACE=./output/runner
CRONY_SOURCE_REPOSITORY=.
CRONY_SOURCE_BASE_REF=HEAD
ECORP_FACTORY_PUBLICATION_BASE_REF=main
ECORP_PUBLICATION_PUBLISHER_ID=crony-cli:local
CRONY_FAKE_AGENT_SCRIPT=./scripts/fake-agent.mjs
# Optional real provider executables.
# CRONY_CLAUDE_COMMAND=claude
# CRONY_CLAUDE_COMMAND_ARGS=
# CRONY_OPENCODE_COMMAND=opencode
# CRONY_OPENCODE_COMMAND_ARGS=
# GitHub Copilot SDK. With no runtime override, the official Rust SDK uses its
# bundled compatible Copilot CLI. An existing Copilot runtime can be connected
# by host and port, or an explicitly provisioned compatible CLI can be selected.
# CRONY_COPILOT_RUNTIME_URL=tcp://127.0.0.1:4321
# CRONY_COPILOT_CLI_PATH=C:/tools/copilot.exe
# CRONY_COPILOT_CLI_PREFIX_ARGS=
# CRONY_COPILOT_CONNECTION_TOKEN_FILE=./secrets/copilot-connection-token
# CRONY_COPILOT_GITHUB_TOKEN_FILE=./secrets/github-copilot-token
CRONY_COPILOT_HOME=./output/runner/copilot-home
CRONY_COPILOT_USE_LOGGED_IN_USER=true
CRONY_COPILOT_LOG_LEVEL=warning
# CI-only deterministic simulator; leave false for the official SDK runtime.
CRONY_COPILOT_FIXTURE=false
CRONY_RUNNER_GRACE_SECS=5
CRONY_RUNNER_CREDENTIAL_TTL_SECS=86400
CRONY_MODE=development
# Leave unset in development; its built-in key is development-only.
# Production requires a fresh private 32-byte key through trusted host configuration.
CRONY_SECRET_MASTER_KEY_HEX=
CRONY_OBJECT_STORE_BACKEND=local
CRONY_OBJECT_STORE_LOCAL_ROOT=./output/artifact-objects
CRONY_ARTIFACT_MAX_BYTES=16777216
CRONY_ARTIFACT_RETENTION_DAYS=30
CRONY_ARTIFACT_SIGNING_KEY_HEX=4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c
# S3-compatible production example:
# CRONY_OBJECT_STORE_BACKEND=s3
# CRONY_OBJECT_STORE_ENDPOINT=https://s3.example.com
# CRONY_OBJECT_STORE_BUCKET=crony-artifacts
# CRONY_OBJECT_STORE_REGION=us-east-1
# CRONY_OBJECT_STORE_ACCESS_KEY=
# CRONY_OBJECT_STORE_SECRET_KEY=
# CRONY_OBJECT_STORE_ALLOW_HTTP=false
# Production requires an HTTPS OpenID Connect issuer and bearer tokens.
# CRONY_MODE=production
# CRONY_OIDC_ISSUER=https://identity.example.com/
# CRONY_CORS_ORIGINS=https://crony.example.com
VITE_CRONY_SERVER_HTTP=http://127.0.0.1:8791
RUST_LOG=crony_server=info,crony_runner=info,tower_http=info
