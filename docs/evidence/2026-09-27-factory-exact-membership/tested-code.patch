+
+        fn discovery(items: Vec<Value>) -> Vec<Read> {
+            let identity = json!({"id": "opaque-project:/A+b==", "number": 3,
+                "owner": {"login": "Owner"}});
+            let cursor = (!items.is_empty()).then_some("opaque-cursor:/B+c==");
+            let mut page = identity.clone();
+            page["items"] = json!({"totalCount": items.len(), "nodes": items,
+                "pageInfo": {"hasNextPage": false, "endCursor": cursor}});
+            vec![
+                read(
+                    "repositoryOwner(login:$owner)",
+                    json!({"owner": "owner", "number": 3}),
+                    json!({"data": {"repositoryOwner": {"projectV2": identity}}}),
+                ),
+                read(
+                    "archivedStates:[NOT_ARCHIVED]",
+                    json!({"id": "opaque-project:/A+b==", "cursor": null}),
+                    json!({"data": {"node": page}}),
+                ),
+            ]
+        }
+
+        fn exact(node: Value) -> Read {
+            read(
+                "... on ProjectV2Item",
+                json!({"id": "project-item"}),
+                json!({"data": {"node": node}}),
+            )
+        }
