+        fn item() -> Value {
+            json!({
+                "__typename": "ProjectV2Item", "id": "project-item", "isArchived": false,
+                "project": {"number": 3, "owner": {"login": "Owner"}},
+                "fieldValueByName": {"name": "Todo"},
+                "content": {"__typename": "Issue", "id": "issue-node", "number": 113,
