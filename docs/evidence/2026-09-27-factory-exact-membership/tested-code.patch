+        use super::*;
+
+        struct Read {
+            query: &'static str,
+            variables: Value,
+            response: anyhow::Result<Value>,
+        }
+
+        fn read(query: &'static str, variables: Value, response: Value) -> Read {
+            Read {
+                query,
+                variables,
+                response: Ok(response),
+            }
+        }
+
+        fn lookup(
+            args: &FactoryArgs,
+            reads: Vec<Read>,
+        ) -> anyhow::Result<super::super::ProjectItemsEnvelope> {
+            let mut reads = reads.into_iter();
+            let result =
+                super::super::load_requested_project_items_with(args, |query, variables| {
+                    let expected = reads.next().expect("unexpected GitHub lookup");
+                    assert!(query.trim_start().starts_with("query("));
+                    assert!(query.contains(expected.query));
+                    assert_eq!(variables, expected.variables);
+                    expected.response
+                });
+            assert!(reads.next().is_none(), "required GitHub read did not run");
+            result
+        }
+
+        fn memberships(nodes: Vec<Value>) -> Read {
+            read(
+                "repository(owner:$owner,name:$repo)",
+                json!({"owner": "owner", "repo": "repo", "number": 113}),
+                json!({"data": {"repository": {"issue": {"projectItems": {
+                    "pageInfo": {"hasNextPage": false}, "nodes": nodes
+                }}}}}),
+            )
+        }
+
+        fn membership() -> Value {
