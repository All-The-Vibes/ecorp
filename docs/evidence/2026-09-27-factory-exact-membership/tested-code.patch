+fn factory_issue_url_matches(url: &str, repository: &str, number: i64) -> bool {
+    if number <= 0 {
+        return false;
+    }
+    let suffix = format!("/issues/{number}");
+    let Some(url_repository) = url
+        .trim_end_matches('/')
+        .strip_prefix("https://github.com/")
+        .and_then(|path| path.strip_suffix(&suffix))
+    else {
+        return false;
+    };
+    let Ok((owner, name)) = repository_parts(url_repository) else {
+        return false;
+    };
+    [owner, name].into_iter().all(|component| {
+        !matches!(component, "." | "..")
+            && component
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+    }) && url_repository.eq_ignore_ascii_case(repository)
 }
 
