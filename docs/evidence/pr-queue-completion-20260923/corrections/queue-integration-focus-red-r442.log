  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-

        runs-on: ubuntu-latest
        timeout-minutes: 30
        env:
          ECORP_CI_OWNED_SERVER: '1'
          CRONY_SERVER_HTTP: http://127.0.0.1:18471
          CRONY_TEST_SERVER_BINARY: ${{ github.workspace }}/target/debug/crony-server
          CRONY_TEST_SERVER_PID_FILE: ${{ github.workspace }}/output/server-ci.json
          DATABASE_URL: postgres://crony:crony@127.0.0.1:55471/crony
        services:
          postgres:
            image: postgres:17-alpine
            env:
              POSTGRES_USER: crony
              POSTGRES_PASSWORD: crony
              POSTGRES_DB: crony
            ports:
              - 55471:5432
            options: >-
              --health-cmd "pg_isready -U crony -d crony"
              --health-interval 2s
              --health-timeout 3s
              --health-retries 30
        steps:
          - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
            with:
              persist-credentials: false
              fetch-depth: 0
          - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable
            with:
              toolchain: 1.98.1
          - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
            with:
              version: 11.19.0
          - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
            with:
              node-version-file: .node-version
              cache: pnpm
          - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
          - run: pnpm install --frozen-lockfile
          - run: cargo build --locked -p crony-server -p crony-runner -p crony-cli -p crony-gateways
          - name: Verify native read-only MCP protocol and probe
            env:
              CRONY_MCP_TEST_BINARY: ${{ github.workspace }}/target/debug/crony-mcp
            run: node --test tools/probe_mcp.test.mjs tools/operation_receipt.test.mjs tools/consume_operation_receipt.test.mjs
          - name: Start control and execution planes
            shell: bash
            run: |
              mkdir -p output
              node tools/ci_owned_test_server.mjs --dry-run
              node tools/ci_owned_test_server.mjs --start
              DEMO_JSON="$(curl --fail --silent -X POST \
                -H 'content-type: application/json' \
                -d '{}' \
                http://127.0.0.1:18471/api/demo/bootstrap)"
              CORP_ID="$(node -e 'console.log(JSON.parse(process.argv[1]).corp_id)' "$DEMO_JSON")"
              ALICE_ID="$(node -e 'console.log(JSON.parse(process.argv[1]).alice_actor_id)' "$DEMO_JSON")"
              ENROLLMENT_JSON="$(curl --fail --silent -X POST \
                -H 'content-type: application/json' \
                -d "{\"actor_id\":\"$ALICE_ID\",\"runner_id\":\"runner-local\",\"expires_in_seconds\":600}" \
                "http://127.0.0.1:18471/api/corps/$CORP_ID/runners/enroll")"
              mkdir -p output/runner
              node -e 'process.stdout.write(JSON.parse(process.argv[1]).enrollment_token)' \
                "$ENROLLMENT_JSON" > output/runner/enrollment.token
              chmod 600 output/runner/enrollment.token
              target/debug/crony-runner \
                --server-ws ws://127.0.0.1:18471/ws/runner \
                --runner-id runner-local \
                --corp-id "$CORP_ID" \
                --credential-file "$PWD/output/runner/credential.json" \
                --enrollment-token-file "$PWD/output/runner/enrollment.token" \
                --workspace "$PWD/output/runner" \
                --source-repository "$PWD" \
                --source-base-ref HEAD \
                --fake-agent-script "$PWD/scripts/fake-agent.mjs" \
                --codex-command node \
                --codex-command-arg "$PWD/scripts/fake-codex-app-server.mjs" \
                --claude-command node \
                --claude-command-arg "$PWD/scripts/fake-external-agent.mjs" \
                --opencode-command node \
                --opencode-command-arg "$PWD/scripts/fake-external-agent.mjs" \
                --copilot-fixture \
                > output/runner-ci.log 2>&1 &
              echo $! > output/runner-ci.pid
          - name: Wait for runner
            shell: bash
            run: |
              for attempt in $(seq 1 60); do
                if curl --fail --silent http://127.0.0.1:18471/health | grep -q '"runners":1'; then
                  exit 0
                fi
                sleep 1
              done
              cat output/server-ci.stdout.log output/server-ci.stderr.log || true
              cat output/runner-ci.log || true
              exit 1
          - name: Race demo bootstrap and reset lifecycle
            run: node tools/e2e_demo_lifecycle.mjs
          - name: Exercise the real server-to-runner path
            shell: pwsh
            run: ./tools/e2e_smoke.ps1 -Server $env:CRONY_SERVER_HTTP
          - name: Verify content-addressed artifacts, provenance, and Corp-scoped download
            run: node tools/e2e_artifacts.mjs
          - name: Verify portable source deliverables, exact linkage, and cleanup acknowledgment
            run: node tools/e2e_portable_deliverables.mjs
          - name: Verify Codex start, steer, resume, interrupt, stop, usage, and evidence
            run: node tools/e2e_codex.mjs
          - name: Verify external CLI providers fail closed on Unix
            env:
              CRONY_EXTERNAL_ADAPTER_TEST: '1'
              CRONY_SERVER_HTTP: http://127.0.0.1:18471
            run: |
              node tools/e2e_external_adapters.mjs --expect-unix --dry-run
              node tools/e2e_external_adapters.mjs --expect-unix
          - name: Verify GitHub Copilot harness, model discovery, selection, and resume
            run: node tools/e2e_copilot.mjs
          - name: Verify MCP, ACP, and A2A gateway conformance
            run: node tools/e2e_gateways.mjs
          - name: Verify parallel worktree isolation and source-checkout preservation
            run: node tools/e2e_worktrees.mjs
          - name: Verify bounded task-graph planning, scheduling, and retries
            env:
              CRONY_TASK_GRAPH_TEST: '1'
              CRONY_SERVER_HTTP: http://127.0.0.1:18471
            run: |
              node tools/e2e_task_graph.mjs --dry-run
              node tools/e2e_task_graph.mjs
          - name: Verify automated, failed, human, and independent evidence gates
            run: node tools/e2e_verification.mjs
          - name: Verify resumable event replay
            run: node tools/e2e_replay.mjs
          - name: Verify control fencing and emergency stop
            run: node tools/e2e_leases.mjs
          - name: Verify room threads and membership isolation
            run: node tools/e2e_rooms.mjs
          - name: Verify cache-policy recovery and resume admission with real SQL
            env:
              DATABASE_URL: postgres://crony:crony@127.0.0.1:54329/crony
            run: cargo test -p crony-server cache_admission_lifecycle_tests --locked -- --ignored --test-threads=1
          - name: Verify runner grace and reconciliation
            run: node tools/e2e_runner_reconnect.mjs
          - name: Verify duplicate runner delivery is idempotent
            run: node tools/e2e_idempotency.mjs
          - name: Verify atomic artifact staging, cleanup, and restart recovery
            env:
              CRONY_ARTIFACT_STAGING_TEST: '1'
              CRONY_SERVER_HTTP: http://127.0.0.1:18471
            run: |
              node tools/e2e_artifact_staging.mjs --dry-run
              node tools/e2e_artifact_staging.mjs
          - name: Verify fenced factory claims, restart recovery, and one linked mission
            run: node tools/e2e_factory_claims.mjs
          - name: Verify Project eligibility, dry run, dispatch, status sync, and replay
            run: node tools/e2e_factory_controller.mjs
          - name: Verify idempotent branch and pull-request publication with recovery
            run: node tools/e2e_factory_publication.mjs
          - name: Verify OIDC, Corp RBAC, runner enrollment, rotation, replay defense, and revocation
            env:
              CRONY_IDENTITY_TEST: '1'
              CRONY_AUTH_TEST_PORT: '18473'
              FAKE_OIDC_PORT: '18472'
            run: |
              node tools/e2e_identity.mjs --dry-run
              node tools/e2e_identity.mjs
          - name: Verify scoped secret brokering without plaintext leakage
            run: node tools/e2e_secrets.mjs
          - name: Verify durable risky-action approvals and exactly-once decision effects
            run: node tools/e2e_approvals.mjs
          - name: Verify budget and loop circuit-breaker stages
            env:
              CRONY_BUDGET_TEST: '1'
              CRONY_BUDGET_RUNNER_ID: runner-local
              CRONY_BUDGET_OUTPUT: ${{ github.workspace }}/output/e2e-budgets.json
            run: |
              node tools/e2e_budgets.mjs --dry-run
              node tools/e2e_budgets.mjs
          - name: Verify terminal provider cleanup and off-shift agent state
            run: node tools/e2e_idle_cleanup.mjs
          - name: Run the versioned 100-scenario deterministic evaluation lane
            run: node tools/run_evals.mjs
          - name: Consolidate chaos and restart evidence
            run: node tools/e2e_chaos_report.mjs
          - name: Stop the ownership-verified CI server
            if: always()
            run: node tools/ci_owned_test_server.mjs --stop
          - name: Upload runtime evidence
            if: always()
            uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
            with:
              name: integration-evidence
