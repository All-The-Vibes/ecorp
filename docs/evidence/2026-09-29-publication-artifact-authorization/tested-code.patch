+const source = Object.freeze({
+  id: 'deliverable-a', task_id: 'task-a', run_id: 'run-a', artifact_id: 'artifact-a',
+  head_commit: 'a'.repeat(40), sha256: 'b'.repeat(64), verification_sha256: 'c'.repeat(64),
+})
