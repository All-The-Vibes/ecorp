+        store
+            .claim_human_requested_publication(&scope, id, "after-revocation".into(), 300)
+            .await
+            .is_err()
+    );
+    // Non-authorizing readback still supports the native failure-only path.
+    assert!(
+        store
+            .human_requested_publication_for_publisher(&scope, id, None)
