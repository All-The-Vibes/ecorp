+        .await;
+        assert_denied(
+            &store,
+            &before,
+            store
+                .renew_pull_request_publication(publication_renewal(&changed, &started))
+                .await,
+        )
+        .await;
+        assert_denied(
+            &store,
+            &before,
+            store
+                .record_pull_request_publication_checkpoint(branch_checkpoint(&changed, &started))
+                .await,
+        )
+        .await;
+    }
