{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ECorp: Check repository",
      "type": "shell",
      "command": "pnpm",
      "args": ["check"],
      "windows": { "command": "pnpm.cmd" },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "ECorp: Check documentation",
      "type": "shell",
      "command": "pnpm",
      "args": ["check:docs"],
      "windows": { "command": "pnpm.cmd" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ECorp: Test web and tools",
      "type": "shell",
      "command": "pnpm",
      "args": ["test:unit"],
      "windows": { "command": "pnpm.cmd" },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
